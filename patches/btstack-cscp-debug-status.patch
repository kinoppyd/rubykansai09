+uint8_t cycling_speed_and_cadence_service_server_get_measurement_status(void){
+	cycling_speed_and_cadence_t * instance = &cycling_speed_and_cadence;
+	uint8_t status = 0;
+	if (instance->con_handle != HCI_CON_HANDLE_INVALID) status |= 1u;
+	if (instance->measurement_client_configuration_descriptor_notify) status |= 2u;
+	if (instance->measurement_pending) status |= 4u;
+	status |= instance->measurement_diagnostic_status;
+	return status;
+}
