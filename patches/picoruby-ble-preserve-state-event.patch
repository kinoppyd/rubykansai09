-  if (packet != NULL) {
-    mrb_free(_mrb, packet);
+  if (_mrb == NULL || !BLE_event_queue_make_room(data, size)) {
+    packet_mutex = false;
+    return;
   }
-  packet = mrb_malloc(_mrb, packet_size);
-  memcpy(packet, data, packet_size);
+
+  uint8_t tail = (packet_queue_head + packet_queue_count) % BLE_EVENT_QUEUE_CAPACITY;
+  packet_queue_size[tail] = size;
+  packet_queue[tail] = mrb_malloc(_mrb, size);
+  memcpy(packet_queue[tail], data, size);
+  packet_queue_count++;
+  packet_flag = true;
   packet_mutex = false;
 }
 
