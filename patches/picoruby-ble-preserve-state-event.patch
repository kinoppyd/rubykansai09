 static mrb_value write_values;
 static mrb_value read_values;
 
+#define BLE_EVENT_BTSTACK_STATE 0x60
+#define BLE_EVENT_LE_META 0x3e
+#define BLE_EVENT_META_GAP 0xe7
+#define BLE_SUBEVENT_LE_CONNECTION_COMPLETE 0x01
+#define BLE_SUBEVENT_LE_ENHANCED_CONNECTION_COMPLETE_V1 0x0a
+#define BLE_SUBEVENT_LE_ENHANCED_CONNECTION_COMPLETE_V2 0x29
+#define BLE_GAP_SUBEVENT_LE_CONNECTION_COMPLETE 0x08
+#define BLE_GAP_EVENT_ADVERTISING_REPORT 0xda
+#define BLE_SUBEVENT_LE_ADVERTISING_REPORT 0x02
+#define BLE_EVENT_COMMAND_COMPLETE 0x0e
+#define BLE_EVENT_COMMAND_STATUS 0x0f
+#define BLE_EVENT_QUEUE_CAPACITY 8
+
+static uint8_t *packet_queue[BLE_EVENT_QUEUE_CAPACITY] = { NULL };
+static uint16_t packet_queue_size[BLE_EVENT_QUEUE_CAPACITY] = { 0 };
+static uint8_t packet_queue_head = 0;
+static uint8_t packet_queue_count = 0;
+
+static bool
+BLE_event_is_btstack_state(const uint8_t *data, uint16_t size)
+{
+  return 0 < size && data[0] == BLE_EVENT_BTSTACK_STATE;
+}
+
+static bool
+BLE_event_is_connection_complete(const uint8_t *data, uint16_t size)
+{
+  if (size <= 2) return false;
+  switch (data[0]) {
+    case BLE_EVENT_LE_META:
+      switch (data[2]) {
+        case BLE_SUBEVENT_LE_CONNECTION_COMPLETE:
+        case BLE_SUBEVENT_LE_ENHANCED_CONNECTION_COMPLETE_V1:
+        case BLE_SUBEVENT_LE_ENHANCED_CONNECTION_COMPLETE_V2:
+          return true;
+        default:
+          return false;
+      }
+    case BLE_EVENT_META_GAP:
+      return data[2] == BLE_GAP_SUBEVENT_LE_CONNECTION_COMPLETE;
+    default:
+      return false;
+  }
+}
+
+static bool
+BLE_event_is_scan_report(const uint8_t *data, uint16_t size)
+{
+  if (size == 0) return false;
+  if (data[0] == BLE_GAP_EVENT_ADVERTISING_REPORT) return true;
+  return size > 2 &&
+         data[0] == BLE_EVENT_LE_META &&
+         data[2] == BLE_SUBEVENT_LE_ADVERTISING_REPORT;
+}
+
+static bool
+BLE_event_is_discardable(const uint8_t *data, uint16_t size)
+{
+  if (BLE_event_is_btstack_state(data, size)) return false;
+  if (BLE_event_is_connection_complete(data, size)) return false;
+  if (BLE_event_is_scan_report(data, size)) return true;
+  if (size == 0) return true;
+  return data[0] == BLE_EVENT_COMMAND_COMPLETE ||
+         data[0] == BLE_EVENT_COMMAND_STATUS;
+}
+
+static void
+BLE_event_queue_remove(uint8_t offset)
+{
+  if (packet_queue_count == 0 || packet_queue_count <= offset) return;
+  uint8_t index = (packet_queue_head + offset) % BLE_EVENT_QUEUE_CAPACITY;
+  if (packet_queue[index] != NULL) {
+    mrb_free(_mrb, packet_queue[index]);
+    packet_queue[index] = NULL;
+  }
+  for (uint8_t i = offset; i + 1 < packet_queue_count; i++) {
+    uint8_t dst = (packet_queue_head + i) % BLE_EVENT_QUEUE_CAPACITY;
+    uint8_t src = (packet_queue_head + i + 1) % BLE_EVENT_QUEUE_CAPACITY;
+    packet_queue[dst] = packet_queue[src];
+    packet_queue_size[dst] = packet_queue_size[src];
+  }
+  uint8_t tail = (packet_queue_head + packet_queue_count - 1) % BLE_EVENT_QUEUE_CAPACITY;
+  packet_queue[tail] = NULL;
+  packet_queue_size[tail] = 0;
+  packet_queue_count--;
+  packet_flag = 0 < packet_queue_count;
+}
+
+static bool
+BLE_event_queue_make_room(const uint8_t *data, uint16_t size)
+{
+  if (packet_queue_count < BLE_EVENT_QUEUE_CAPACITY) return true;
+  if (BLE_event_is_discardable(data, size)) return false;
+
+  for (uint8_t i = 0; i < packet_queue_count; i++) {
+    uint8_t index = (packet_queue_head + i) % BLE_EVENT_QUEUE_CAPACITY;
+    if (BLE_event_is_discardable(packet_queue[index], packet_queue_size[index])) {
+      BLE_event_queue_remove(i);
+      return true;
+    }
+  }
+
+  BLE_event_queue_remove(0);
+  return true;
+}
+
