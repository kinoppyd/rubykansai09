+static mrb_value
+mrb_i2c_read_into(mrb_state *mrb, mrb_value self)
+{
+  mrb_value *args;
+  mrb_value buffer;
+  mrb_int argc;
+  mrb_int i2c_adrs_7;
+  mrb_int timeout_ms;
+  const mrb_sym kw_names[] = { MRB_SYM(timeout) };
+  mrb_value kw_values[1];
+  mrb_kwargs kwargs = { 1, 0, kw_names, kw_values, NULL };
+
+  mrb_get_args(mrb, "iS*:", &i2c_adrs_7, &buffer, &args, &argc, &kwargs);
+  mrb_int len = RSTRING_LEN(buffer);
+  if (len <= 0) mrb_raise(mrb, E_ARGUMENT_ERROR, "buffer must not be empty");
+
+  mrb_int unit_num = mrb_fixnum(mrb_iv_get(mrb, self, MRB_IVSYM(unit_num)));
+  timeout_ms = mrb_undef_p(kw_values[0]) ?
+    mrb_fixnum(mrb_iv_get(mrb, self, MRB_IVSYM(timeout))) : mrb_fixnum(kw_values[0]);
+
+  if (argc > 0) {
+    mrb_int res = mrb_i2c_write_outputs(mrb, unit_num, i2c_adrs_7, args, argc, timeout_ms, true);
+    if (res < 0) mrb_raise(mrb, IOError, "I2C write (for read) failed");
+  }
+
+  mrb_str_modify(mrb, mrb_str_ptr(buffer));
+  int ret = I2C_read_timeout_us(
+    (uint8_t)unit_num, (uint8_t)i2c_adrs_7, (uint8_t *)RSTRING_PTR(buffer),
+    (size_t)len, false, (uint32_t)timeout_ms * 1000
+  );
+  if (ret != len) mrb_raise(mrb, IOError, "I2C short read");
+  return buffer;
+}
