+static void
+c_read_into(mrbc_vm *vm, mrbc_value *v, int argc)
+{
+  if (argc < 2 || v[2].tt != MRBC_TT_STRING) {
+    mrbc_raise(vm, MRBC_CLASS(ArgumentError), "address and String buffer required");
+    return;
+  }
+
+  mrbc_int_t i2c_adrs_7 = GET_INT_ARG(1);
+  mrbc_value *buffer = &v[2];
+  mrbc_int_t len = buffer->string->size;
+  if (len <= 0) {
+    mrbc_raise(vm, MRBC_CLASS(ArgumentError), "buffer must not be empty");
+    return;
+  }
+  mrbc_int_t unit_num = mrbc_integer(mrbc_instance_getiv(&v[0], mrbc_str_to_symid("unit_num")));
+  mrbc_int_t timeout_ms = mrbc_integer(mrbc_instance_getiv(&v[0], mrbc_str_to_symid("timeout")));
+
+  if (argc > 2 && v[argc].tt == MRBC_TT_HASH) {
+    mrbc_value timeout_key = mrbc_symbol_value(mrbc_str_to_symid("timeout"));
+    mrbc_value timeout_val = mrbc_hash_get(&v[argc], &timeout_key);
+    if (timeout_val.tt == MRBC_TT_INTEGER) timeout_ms = mrbc_integer(timeout_val);
